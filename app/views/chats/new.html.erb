<% content_for :title, "New chat" %>

<div class="flex min-h-0 flex-1 flex-col">
  <%# Navbar kept (toggle only) so the sidebar is still reachable on small screens. %>
  <header class="navbar gap-1 bg-base-100">
    <%= render "chats/sidebar_toggle" %>
  </header>

  <%# Greeting and composer, centred together like an empty state. %>
  <div class="flex min-h-0 flex-1 flex-col justify-center">
    <p class="mx-auto w-full max-w-3xl px-4 pb-2 text-center text-2xl font-semibold">
      How can I help you today?
    </p>

    <%= render "messages/form", message: @message, url: chats_path %>
  </div>
</div>
