<%# The drawer checkbox lives in the chats layout; this label toggles it on small
    screens, where the sidebar is collapsed by default. Hidden on desktop. %>
<label for="chats-drawer" class="btn btn-square btn-sm btn-ghost lg:hidden" aria-label="Toggle chat list">
  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
  </svg>
</label>
