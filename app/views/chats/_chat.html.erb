<li id="<%= dom_id(chat) %>" class="group flex items-center gap-1 rounded-lg hover:bg-base-300"
    data-chats-list-target="item" data-chat-id="<%= chat.id %>">
  <%= link_to chat,
        data: { turbo_frame: :chats_main },
        class: "flex min-w-0 flex-1 items-center gap-2 rounded-lg px-3 py-2 text-sm" do %>
    <span class="flex h-4 w-4 shrink-0 items-center justify-center" aria-hidden="true">
      <% if chat.responding? %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="h-4 w-4 animate-spin text-primary">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 0 1 4 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      <% else %>
        <span class="h-1.5 w-1.5 rounded-full bg-base-content/25"></span>
      <% end %>
    </span>
    <span class="min-w-0 truncate"><%= truncate(chat.display_title, length: 32) %></span>
  <% end %>

  <div class="dropdown dropdown-end pr-1">
    <div tabindex="0" role="button" aria-label="Chat actions"
         class="btn btn-ghost btn-xs opacity-0 group-hover:opacity-100 focus-visible:opacity-100">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm6 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm6 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
      </svg>
    </div>

    <ul tabindex="0" class="dropdown-content z-50 w-40 rounded-box bg-base-100 p-1 shadow-md">
      <li>
        <%= button_to "Delete", chat, method: :delete,
              params: { source: "sidebar" },
              data: { turbo_confirm: "Delete this chat?" },
              class: "w-full cursor-pointer rounded-md px-3 py-2 text-left text-sm text-error hover:bg-error/10" %>
      </li>
    </ul>
  </div>
</li>
