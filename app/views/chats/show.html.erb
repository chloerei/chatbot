<% content_for :title, @chat.title %>

<%= turbo_stream_from @chat %>

<%# The chat fills the column: a full-width navbar, a growing (scrollable)
    message area, and the composer pinned at the bottom. Both the messages and
    the composer are centred inside a shared max width. %>
<div class="flex min-h-0 flex-1 flex-col">
  <header class="navbar gap-1 bg-base-100">
    <%= render "chats/sidebar_toggle" %>

    <h1 class="min-w-0 flex-1 truncate px-1 font-semibold"><%= @chat.title %></h1>

    <div class="dropdown dropdown-end">
      <div tabindex="0" role="button" aria-label="Chat actions" class="btn btn-square btn-sm btn-ghost">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm6 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm6 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
        </svg>
      </div>

      <ul tabindex="0" class="dropdown-content z-50 w-40 rounded-box bg-base-100 p-1 shadow-md">
        <li>
          <%= button_to "Delete", @chat, method: :delete,
                params: { source: "chat" },
                data: { turbo_frame: "_top", turbo_confirm: "Delete this chat?" },
                class: "w-full cursor-pointer rounded-md px-3 py-2 text-left text-sm text-error hover:bg-error/10" %>
        </li>
      </ul>
    </div>
  </header>

  <%# The scroll container spans the full width; the message list keeps its own
      max width and stays the Turbo Stream append target. %>
  <div class="min-h-0 grow flex flex-col-reverse overflow-y-auto">
    <div class="sticky bottom-0">
      <%= render "messages/form", message: @message, url: [ @chat, @message ] %>
    </div>

    <div id="messages" class="mx-auto flex w-full max-w-3xl flex-col gap-4 px-4 py-6">
      <% @chat.messages.each do |message| %>
        <%= render message %>
      <% end %>
    </div>
  </div>
</div>
