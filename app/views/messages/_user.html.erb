<% user ||= local_assigns[:message] %>
<%# Right-aligned primary bubble, like other chat UIs. %>
<div id="message_<%= user.id %>" class="flex justify-end">
  <div class="max-w-[85%] rounded-2xl rounded-br-md bg-primary px-4 py-2 text-primary-content">
    <div id="message_<%= user.id %>_content" data-controller="markdown" class="wrap-break-word">
      <div data-markdown-target="output" class="markdown"></div>
      <div id="message_<%= user.id %>_content_source" data-markdown-target="source" hidden><%= user.content %></div>
    </div>
  </div>
</div>
