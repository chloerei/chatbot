<%# locals: (message:, text:, streaming: false) %>
<%# The model's reasoning, above its answer. DaisyUI's collapse keeps it folded
    by default and folds it without JavaScript; collapse-arrow draws the
    disclosure icon on the trailing edge. The summary is the leading status icon
    — a spinner while the model is still reasoning, a bulb once it has finished
    — plus the title. Its own horizontal padding is dropped so the block lines up
    with the answer beside it. The expanded text sits in a column that starts
    under the title, beside a rule centred on the icon above it. The job inserts
    this region when reasoning starts and appends to its content; once reasoning
    ends the region is rendered settled, and the final re-render fills it from
    the persisted text. %>
<details id="message_<%= message.id %>_thinking" class="collapse collapse-arrow">
  <summary class="collapse-title px-0 text-sm font-medium text-base-content/60">
    <span class="flex items-center gap-2">
      <%# Decorative, so hidden from assistive tech; the title carries the meaning. %>
      <% if streaming %>
        <svg class="h-4 w-4 shrink-0 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 0 1 4 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      <% else %>
        <svg class="h-4 w-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
        </svg>
      <% end %>
      Thinking
    </span>
  </summary>
  <%# The rule column is the icon's width with the rule centred in it, so it hangs
      straight below the icon; the text column lines up with the title beside it. %>
  <div class="collapse-content flex gap-2 px-0">
    <span class="flex w-4 shrink-0 justify-center">
      <span class="w-0.5 rounded-full bg-base-300"></span>
    </span>
    <div id="message_<%= message.id %>_thinking_content" class="flex-1 min-w-0 whitespace-pre-wrap wrap-break-word text-sm leading-relaxed text-base-content/70"><%= text %></div>
  </div>
</details>
