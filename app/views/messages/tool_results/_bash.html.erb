<% error_message = tool_result.tool_error_message %>
<% if error_message.present? %>
  <div class="space-y-1 text-sm text-error">
    <div class="font-medium">Bash error</div>
    <pre class="whitespace-pre-wrap overflow-x-auto"><%= error_message %></pre>
  </div>
<% else %>
  <pre class="whitespace-pre-wrap text-gray-700 text-sm overflow-x-auto"><%= tool_result.content.presence || "(no output)" %></pre>
<% end %>
