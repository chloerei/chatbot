<%# The bash result partial. It owns the output region's id: while the command
    runs its chunks are appended there, and the finished output replaces the
    whole region, so both halves render the same way. %>
<pre id="<%= tool_output_dom_id(tool_call) %>" class="whitespace-pre-wrap wrap-break-word overflow-x-auto rounded-md bg-base-200 p-2"><%= tool_result&.content %></pre>
