<% error_message = tool.tool_error_message %>
<% if error_message.present? %>
  <%= render "messages/error",
    message: tool,
    title: "Tool result error",
    error_message: error_message %>
<% else %>
  <div id="message_<%= tool.id %>" class="space-y-1 text-sm opacity-70">
    <div class="font-medium">Tool result</div>
    <pre class="overflow-x-auto whitespace-pre-wrap"><%= tool.content.presence || "(no output)" %></pre>
  </div>
<% end %>
