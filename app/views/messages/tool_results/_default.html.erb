<%# The fallback result partial. It owns the output region's id: a running tool
    appends its chunks there, and the finished result replaces the whole region,
    so both halves render the same way. %>
<% error_message = tool_result&.tool_error_message %>
<% if error_message.present? %>
  <div id="<%= tool_output_dom_id(tool_call) %>" class="space-y-1 rounded-md bg-base-200 p-2 text-error">
    <div class="font-medium">Tool result error</div>
    <pre class="whitespace-pre-wrap wrap-break-word overflow-x-auto"><%= error_message %></pre>
  </div>
<% else %>
  <pre id="<%= tool_output_dom_id(tool_call) %>" class="whitespace-pre-wrap wrap-break-word overflow-x-auto rounded-md bg-base-200 p-2"><%= tool_result&.content %></pre>
<% end %>
