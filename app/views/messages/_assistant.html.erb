<% assistant ||= local_assigns[:message] %>
<%# Borderless and backgroundless so consecutive messages read as one column.
    A message's tool calls render inside it, so the message keeps its content
    even when the calls are broadcast. %>
<div id="message_<%= assistant.id %>" class="space-y-2">
  <div id="message_<%= assistant.id %>_content" class="whitespace-pre-wrap wrap-break-word leading-relaxed"><%= assistant.content %></div>

  <% assistant.ruby_llm_tool_calls.each do |tool_call| %>
    <%= render tool_call_partial(tool_call), tool_call: tool_call %>
  <% end %>
</div>
