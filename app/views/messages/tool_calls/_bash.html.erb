<%# The bash card. Same folded shape as the fallback, but the summary carries a
    terminal, since the tool runs commands. The output region's id lives here
    because that is where the command's chunks are appended while it runs and
    where the finished result is replaced in. %>
<details id="<%= tool_call_dom_id(tool_call) %>" class="collapse collapse-arrow">
  <summary class="collapse-title px-0 text-sm font-medium text-base-content/60">
    <span class="flex items-center gap-2">
      <%# A spinner while the call has no result yet, the terminal once it does.
          Decorative, so hidden from assistive tech; the name beside it carries
          the meaning. %>
      <% if tool_call.result.present? %>
        <svg class="h-4 w-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m6.75 7.5 3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0 0 21 18V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v12a2.25 2.25 0 0 0 2.25 2.25Z" />
        </svg>
      <% else %>
        <svg class="h-4 w-4 shrink-0 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 0 1 4 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      <% end %>
      <%= tool_call.name %>
    </span>
  </summary>
  <div class="collapse-content flex gap-2 px-0">
    <span class="flex w-4 shrink-0 justify-center">
      <span class="w-0.5 rounded-full bg-base-300"></span>
    </span>
    <div class="flex-1 min-w-0 space-y-3 text-sm">
      <div class="space-y-1">
        <div class="text-xs font-medium uppercase tracking-wide text-base-content/50">Input</div>
        <pre class="whitespace-pre-wrap wrap-break-word overflow-x-auto rounded-md bg-base-200 p-2"><%= tool_call.name %>(<%= tool_call.arguments.map { |k, v| "#{k}: #{v.inspect}" }.join(", ") %>)</pre>
      </div>

      <div class="space-y-1">
        <div class="text-xs font-medium uppercase tracking-wide text-base-content/50">Output</div>
        <%= render "messages/tool_call_output", tool_call: tool_call %>
      </div>
    </div>
  </div>
</details>
