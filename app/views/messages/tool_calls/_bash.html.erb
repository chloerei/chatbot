<div id="message_tool_call_<%= tool_call.tool_call_id %>" class="w-full sm:w-auto my-5 space-y-3 rounded-md px-3 py-2 bg-gray-50 border border-gray-200">
  <div>
    <span class="inline-block rounded px-2 py-0.5 text-xs font-medium bg-gray-200 text-gray-700">
      Bash
    </span>
  </div>

  <div class="space-y-1">
    <div class="text-xs font-medium uppercase tracking-wide text-gray-500">Input</div>
    <pre class="whitespace-pre-wrap text-gray-700 text-sm overflow-x-auto"><%= tool_call.name %>(<%= tool_call.arguments.map { |k, v| "#{k}: #{v.inspect}" }.join(", ") %>)</pre>
  </div>

  <div class="space-y-1">
    <div class="text-xs font-medium uppercase tracking-wide text-gray-500">Output</div>
    <div id="message_tool_call_<%= tool_call.tool_call_id %>_output">
      <%= render "messages/tool_call_output", tool_call: tool_call %>
    </div>
  </div>

  <div>
    <span class="text-sm text-gray-600"><%= tool_call.created_at&.strftime("%I:%M %p") %></span>
  </div>
</div>
