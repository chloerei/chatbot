<%# The fallback card, folded like the thinking region: the summary carries the
    tool's icon and name, and the input and output hang off a rule in the body. A
    tool with a card of its own gets a partial beside this one, picked by name.
    The output region's id lives here because that is where a running tool's
    chunks are appended and where the finished result is replaced in. %>
<details id="<%= tool_call_dom_id(tool_call) %>" class="collapse collapse-arrow">
  <summary class="collapse-title px-0 py-1 text-sm font-medium text-base-content/60 transition-colors hover:text-base-content/80">
    <span class="flex items-center gap-2">
      <%# A spinner while the call has no result yet, the wrench once it does.
          Decorative, so hidden from assistive tech; the name beside it carries
          the meaning. %>
      <% if tool_call.result.present? %>
        <svg class="h-4 w-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" />
        </svg>
      <% else %>
        <svg class="h-4 w-4 shrink-0 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 0 1 4 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      <% end %>
      <%= tool_call.name %>
    </span>
  </summary>
  <div class="collapse-content px-0 pb-1">
    <div class="flex gap-2 pt-2">
      <span class="flex w-4 shrink-0 justify-center">
        <span class="w-0.5 rounded-full bg-base-300"></span>
      </span>
      <div class="flex-1 min-w-0 space-y-2 text-sm">
        <div class="space-y-1">
          <div class="text-xs font-medium uppercase tracking-wide text-base-content/50">Input</div>
          <pre class="whitespace-pre-wrap wrap-break-word overflow-x-auto rounded-md bg-base-200 p-2"><%= tool_call.name %>(<%= tool_call.arguments.map { |k, v| "#{k}: #{v.inspect}" }.join(", ") %>)</pre>
        </div>

        <div class="space-y-1">
          <div class="text-xs font-medium uppercase tracking-wide text-base-content/50">Output</div>
          <%= render "messages/tool_call_output", tool_call: tool_call %>
        </div>
      </div>
    </div>
  </div>
</details>
