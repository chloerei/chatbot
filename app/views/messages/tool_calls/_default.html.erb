<div id="message_tool_call_<%= tool_call.tool_call_id %>" class="space-y-1 text-sm opacity-70">
  <div class="font-medium">Tool call · <%= tool_call.name %></div>

  <div class="space-y-1">
    <div class="text-xs font-medium uppercase tracking-wide opacity-60">Input</div>
    <pre class="overflow-x-auto whitespace-pre-wrap"><%= tool_call.arguments.map { |k, v| "#{k}: #{v.inspect}" }.join(", ") %></pre>
  </div>

  <div class="space-y-1">
    <div class="text-xs font-medium uppercase tracking-wide opacity-60">Output</div>
    <div id="message_tool_call_<%= tool_call.tool_call_id %>_output">
      <%= render "messages/tool_call_output", tool_call: tool_call %>
    </div>
  </div>
</div>
