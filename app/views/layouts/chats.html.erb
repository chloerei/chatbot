<%# Nested layout: inherits app/views/layouts/application.html.erb through :content. %>
<% content_for :content do %>
  <div class="drawer lg:drawer-open">
    <input id="chats-drawer" type="checkbox" class="drawer-toggle">

    <div class="drawer-content flex min-h-screen flex-col bg-base-100">
      <div class="navbar bg-base-200 lg:hidden">
        <label for="chats-drawer" class="btn btn-square btn-ghost" aria-label="Open chat list">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </label>
        <%= link_to "Chatbot", root_path, class: "text-lg font-bold" %>
      </div>

      <main class="mx-auto w-full max-w-4xl flex-1 p-4">
        <%= yield %>
      </main>
    </div>

    <div class="drawer-side z-40">
      <label for="chats-drawer" class="drawer-overlay" aria-label="Close chat list"></label>

      <aside class="flex min-h-full w-80 flex-col bg-base-200 text-base-content">
        <%= link_to root_path, class: "flex items-center gap-2 p-4" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-8 w-8 text-primary">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3h6M3 15.75v-7.5A2.25 2.25 0 0 1 5.25 6h13.5A2.25 2.25 0 0 1 21 8.25v7.5a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15.75Z" />
          </svg>
          <span class="text-xl font-bold">Chatbot</span>
        <% end %>

        <div class="px-4 pb-2">
          <%= link_to root_path, class: "btn btn-primary w-full" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            New chat
          <% end %>
        </div>

        <div id="chats-list" class="px-4 pb-2" data-turbo-permanent>
          <%= turbo_frame_tag :chats_sidebar, src: chats_path, loading: :lazy, target: "_top",
                class: "flex-1 overflow-y-auto px-2 pb-4" do %>
            <p class="px-3 py-2 text-sm opacity-50">Loading chats…</p>
          <% end %>
        </div>
      </aside>
    </div>
  </div>
<% end %>

<%= render template: "layouts/application" %>
