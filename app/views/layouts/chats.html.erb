<%# Nested layout: inherits app/views/layouts/application.html.erb through :content. %>
<% content_for :content do %>
  <div class="drawer lg:drawer-open">
    <input id="chats-drawer" type="checkbox" class="drawer-toggle">

    <div class="drawer-content flex h-screen flex-col overflow-hidden bg-base-100">
      <main class="flex min-h-0 w-full flex-1 flex-col">
        <%# Sidebar links target this frame, so only the main column is swapped.
            data-turbo-action keeps the address bar and history in sync. %>
        <%= turbo_frame_tag :chats_main, data: { turbo_action: "advance" }, class: "flex min-h-0 flex-1 flex-col" do %>
          <%= yield %>
        <% end %>
      </main>
    </div>

    <div class="drawer-side z-40">
      <label for="chats-drawer" class="drawer-overlay" aria-label="Close chat list"></label>

      <%# No top padding: the logo row owns that space so it can match the navbar's
          4rem band, which starts at the very top of the column.
          Horizontal padding lives on each region instead of on the aside, so the
          chat list can span the full column and put its scrollbar on the drawer edge. %>
      <aside class="flex h-full w-80 flex-col gap-4 bg-base-200 text-base-content">
        <%# Subscribe the drawer to this user's chat changes (create/update/destroy).
            Hidden so the custom element is not a flex child (it would add a gap). %>
        <%= turbo_stream_from Current.user, class: "hidden" %>

        <%# Sits in the same 4rem band as the main navbar so the brand row lines up
            with it. Every region is a plain flex child, so the container's gap
            keeps the spacing between them even. %>
        <%= link_to root_path, data: { turbo_frame: :chats_main },
              class: "mx-4 flex min-h-16 shrink-0 items-center gap-2" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-8 w-8 text-primary">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3h6M3 15.75v-7.5A2.25 2.25 0 0 1 5.25 6h13.5A2.25 2.25 0 0 1 21 8.25v7.5a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15.75Z" />
          </svg>
          <span class="text-xl font-bold">Chatbot</span>
        <% end %>

        <%# No w-full: the aside stretches its children, so mx-4 alone insets it. %>
        <%= link_to root_path, data: { turbo_frame: :chats_main },
              class: "btn btn-primary mx-4 shrink-0" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          New chat
        <% end %>

        <%# The chat list grows to fill the drawer and scrolls on overflow, so the
            logo and the account footer stay put. The scroll container itself is
            full-bleed (no padding), so its scrollbar sits on the drawer edge; the
            inner wrapper carries the horizontal padding that keeps the list aligned
            with the regions above and below. %>
        <div class="min-h-0 flex-1 px-4 overflow-y-auto">
          <%= turbo_frame_tag :chats_sidebar, src: chats_path, loading: :lazy do %>
            <p class="px-3 py-2 text-sm opacity-50">Loading chats…</p>
          <% end %>
        </div>

        <%# Current account, pinned to the bottom of the drawer. %>
        <div class="mx-4 mb-4 flex shrink-0 items-center gap-2">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/15 text-sm font-semibold uppercase text-primary">
            <%= Current.user.email.first %>
          </div>

          <span class="min-w-0 flex-1 truncate text-sm"><%= Current.user.email %></span>

          <%= button_to session_path, method: :delete,
                aria: { label: "Sign out" },
                data: { turbo_confirm: "Sign out?" },
                class: "btn btn-ghost btn-sm btn-square shrink-0" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M9 12h10.5m0 0-3-3m3 3-3 3" />
            </svg>
          <% end %>
        </div>
      </aside>
    </div>
  </div>
<% end %>

<%= render template: "layouts/application" %>
