<% content_for :title, "Update your password" %>

<div class="min-h-dvh flex items-center justify-center bg-base-200 px-4 py-10">
  <div class="card w-full max-w-sm bg-base-100 shadow-xl">
    <div class="card-body gap-5">
      <div class="text-center">
        <h1 class="card-title justify-center text-2xl">Update your password</h1>
        <p class="text-sm text-base-content/60 mt-1">Choose a new password for your account.</p>
      </div>

      <% if flash[:alert] %>
        <div role="alert" class="alert alert-error alert-soft">
          <span><%= flash[:alert] %></span>
        </div>
      <% end %>

      <%= form_with url: password_path(params[:token]), method: :put, class: "flex flex-col gap-2" do |form| %>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">New password</legend>
          <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "input w-full" %>
        </fieldset>

        <fieldset class="fieldset">
          <legend class="fieldset-legend">Repeat new password</legend>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input w-full" %>
        </fieldset>

        <%= form.submit "Save", class: "btn btn-primary w-full mt-2" %>
      <% end %>

      <div class="text-center text-sm">
        <%= link_to "Back to sign in", new_session_path, class: "link link-primary" %>
      </div>
    </div>
  </div>
</div>
