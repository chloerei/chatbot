<% content_for :title, "Forgot password?" %>

<div class="min-h-dvh flex items-center justify-center bg-base-200 px-4 py-10">
  <div class="card w-full max-w-sm bg-base-100 shadow-xl">
    <div class="card-body gap-5">
      <div class="text-center">
        <h1 class="card-title justify-center text-2xl">Forgot password?</h1>
        <p class="text-sm text-base-content/60 mt-1">We'll email you a link to reset it.</p>
      </div>

      <% if flash[:alert] %>
        <div role="alert" class="alert alert-error alert-soft">
          <span><%= flash[:alert] %></span>
        </div>
      <% end %>

      <%= form_with url: passwords_path, class: "flex flex-col gap-2" do |form| %>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Email</legend>
          <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username", value: params[:email], class: "input w-full" %>
        </fieldset>

        <%= form.submit "Email reset instructions", class: "btn btn-primary w-full mt-2" %>
      <% end %>

      <div class="text-center text-sm">
        <%= link_to "Back to sign in", new_session_path, class: "link link-primary" %>
      </div>
    </div>
  </div>
</div>
